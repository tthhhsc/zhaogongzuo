.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(155deg, #0d685a 0%, #084f46 58%, #063a34 100%);
}

.login-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.orbit-one {
  top: -180rpx;
  right: -180rpx;
  width: 580rpx;
  height: 580rpx;
  box-shadow: 0 0 0 90rpx rgba(255, 255, 255, 0.025);
}

.orbit-two {
  bottom: -120rpx;
  left: -180rpx;
  width: 500rpx;
  height: 500rpx;
}

.login-content {
  position: relative;
  z-index: 2;
  padding: calc(96rpx + env(safe-area-inset-top)) 44rpx calc(44rpx + env(safe-area-inset-bottom));
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.13);
  color: #ffd781;
  font-size: 46rpx;
  text-align: center;
  line-height: 88rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.brand-title {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
}

.brand-sub {
  color: rgba(255, 255, 255, 0.62);
  font-size: 23rpx;
}

.hero {
  margin-top: 96rpx;
}

.hero-kicker {
  display: block;
  color: #8fe0c8;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-desc {
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 27rpx;
  line-height: 1.75;
}

.profile-card {
  display: flex;
  align-items: center;
  margin-top: 54rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 30rpx;
  background: rgba(8, 41, 36, 0.42);
}

.avatar-button {
  width: 136rpx;
  height: 136rpx;
  padding: 0;
  border: none;
  border-radius: 38rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.12);
}

.avatar-button::after {
  border: none;
}

.avatar-image {
  width: 136rpx;
  height: 136rpx;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
}

.avatar-plus {
  color: #ffd781;
  font-size: 52rpx;
  line-height: 1;
}

.avatar-tip {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
}

.profile-form {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.profile-label {
  display: block;
  color: rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
}

.nickname-input {
  height: 72rpx;
  margin-top: 10rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.11);
  font-size: 28rpx;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.42);
}

.login-button {
  height: 94rpx;
  margin-top: 36rpx;
  border-radius: 999rpx;
  color: #163a32;
  background: #ffd781;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 94rpx;
}

.login-button::after,
.later-button::after {
  border: none;
}

.later-button {
  height: 76rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.75);
  background: transparent;
  font-size: 26rpx;
  line-height: 76rpx;
}

.privacy-note {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}
