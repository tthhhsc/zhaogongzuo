.head {
  padding: 36rpx 32rpx 40rpx;
  background: linear-gradient(150deg, #0d685a 0%, #074c43 72%, #0a3b34 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.head .section-kicker {
  color: rgba(255, 255, 255, 0.6);
}

.head-title {
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.head-sub {
  display: block;
  color: rgba(255, 255, 255, 0.7);
  font-size: 25rpx;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}

.bar-text {
  font-size: 26rpx;
  color: #53615d;
}

.bar-action {
  font-size: 26rpx;
  color: #c5483c;
}

.list {
  padding: 12rpx 24rpx 0;
}

.job-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 45, 38, 0.05);
}

.job-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.job-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #18211f;
  line-height: 1.4;
  margin-right: 16rpx;
}

.job-salary {
  color: #c5483c;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.job-company {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #53615d;
}

.job-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7d8985;
}

.meta-dot {
  margin: 0 10rpx;
  color: #cad5cf;
}

.job-tags {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.job-tags .type-badge {
  margin: 0 10rpx 10rpx 0;
}

.job-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f4f2;
  font-size: 24rpx;
  color: #7d8985;
}

.job-source {
  color: #0d685a;
}

.job-time {
  margin-left: 16rpx;
}

.fav {
  margin-left: auto;
  width: 60rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 40rpx;
  color: #cad5cf;
}

.fav-on {
  color: #f1ab37;
}

.empty-btn {
  display: inline-flex;
  margin-top: 8rpx;
}
